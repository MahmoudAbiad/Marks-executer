# بيانات تطبيق Telegram (من my.telegram.org) - يستخدمها Telethon
API_ID=
API_HASH=

# توكن بوت تيليجرام (من BotFather) - يستخدمه aiogram
BOT_TOKEN=

# جلسة حساب المراقبة (Telethon StringSession) - يجب توليدها مسبقًا
SESSION_STRING=

# مفتاح Google Gemini API
GEMINI_API_KEY=

# بيانات قاعدة بيانات Turso
TURSO_DB_URL=
TURSO_AUTH_TOKEN=

# معرّف القناة المراقَبة (بدون @ أو رابط، أو ضع الرابط كاملاً وسيُنظَّف تلقائياً)
TARGET_CHANNEL=EnvironmentalTechnologyEng

# الرابط العام للخدمة عند النشر على Render (يُضبط تلقائياً على Render)
RENDER_EXTERNAL_URL=https://marks-executer.onrender.com

# المنفذ (اختياري - يضبطه Render تلقائياً عادة)
PORT=8000
